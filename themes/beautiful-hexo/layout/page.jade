extends partial/base

block header
    .page-logo.text-center
        a(href=url_for())
            img.avatar-img(src=url_for("/logo.png"), alt="Zenobase", width="50", height="50")

block content
    .container
        .row
            .col-lg-8.col-lg-offset-2.col-md-10.col-md-offset-1
                article(role="main", class="blog-post")
                    != page.content

                include partial/comment
