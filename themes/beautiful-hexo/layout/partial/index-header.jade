.hero-unit
  .hero-overlay
    .hero-content.text-center
      a(href="https://zenobase.com")
        img.hero-logo(src=url_for("/img/logo_560x144.png"), alt="Zenobase", width="280", height="72")
      h1.hero-title!= theme.header.title
      p.hero-subtitle!= theme.header.motto
      .hero-cta
        a.hero-btn(href="https://zenobase.com") Open App #[span.hero-btn-arrow &rarr;]
