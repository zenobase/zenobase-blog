extends partial/base

block header
    .page-logo.text-center
        a(href=url_for())
            img.avatar-img(src=url_for("/logo.png"), alt="Zenobase", width="50", height="50")

block content
    .container
        .row
            .col-lg-6.col-lg-offset-3.col-md-10.col-md-offset-1

                ul.list-inline.text-center
                    - site.tags.map(function(tag) {
                        if tag.posts.length > 0
                            li
                                a.badge(href="#"+tag.name, rel=tag.length, style="font-size: 16px; padding: 8px; margin: 5px 5px 5px 5px;")= tag.name
                    - })

                - site.tags.map(function(tag) {
                    if tag.posts.length > 0
                        h2(id=tag.name)
                            span.fa.fa-tag(style="font-size: 0.8em;")
                            |  #{tag.name}
                        .archive-list
                            - var prev_year = 0;
                            - tag.posts.sort('date', -1).each(function(post) {
                            - var current_year = full_date(post.date, 'YYYY')-0;
                            .archive-group
                                if current_year !== prev_year
                                    .archive-year= current_year
                                else
                                    .archive-year
                                - prev_year=current_year;
                                .archive-posts
                                    .archive-post
                                        a.post-title(href=url_for(post.path))= post.title
                            - })
                            - prev_year = 0;
                - })
